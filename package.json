{
  "name": "event-tickets",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:prod": "node scripts/start.mjs --prod",
    "dev:api": "npm run dev -w @et/api",
    "dev:web": "npm run dev -w @et/web",
    "build": "npm run build -w @et/api && npm run build -w @et/web",
    "build:demo": "npm run build:demo -w @et/web",
    "db:migrate": "npm run db:migrate -w @et/api",
    "db:seed": "npm run db:seed -w @et/api",
    "typecheck": "npm run typecheck -ws --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test -ws --if-present",
    "wa:test": "npm run wa:test -w @et/api --"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
