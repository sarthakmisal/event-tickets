# Required
DATABASE_URL=postgres://user:password@localhost:5432/event_tickets
APP_SECRET=change-me-to-a-random-string-of-32+-chars   # signs sessions, encrypts the kwskit API key

# Recommended in production
NODE_ENV=production
PUBLIC_URL=https://your-domain.com      # used for booking QR links and ticket URLs
TRUST_PROXY=1                           # set when running behind Nginx / a load balancer
# PGSSL=require                         # for hosted Postgres (Neon, RDS, Supabase)

# Payments: your gateway/server calls POST /api/webhooks/payment signed with this secret
PAYMENT_WEBHOOK_SECRET=another-long-random-string

# WhatsApp (kwskit): base URL of the provider API, see src/whatsapp.js
# KWSKIT_BASE_URL=https://api.kwskit.example
