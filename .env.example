# --- API (apps/api) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://user:password@localhost:5432/event_tickets
APP_SECRET=change-me-to-a-random-string-of-at-least-32-characters
PUBLIC_WEB_URL=http://localhost:5173
TRUST_PROXY=0
ENABLE_JOBS=true

# Payments: "mock" works without any account (not allowed in production). Use "razorpay" for real payments.
PAYMENT_PROVIDER=mock
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# WhatsApp: "console" prints messages to the log. "cloud-api" = official Meta WhatsApp Cloud API.
# console = print to API log | qr = link a number by scanning a QR (unofficial, ban risk, needs always-on server) | cloud-api = official Meta
WHATSAPP_PROVIDER=console
# qr mode: gap between messages (seconds) and a daily cap per linked number
# WHATSAPP_MIN_GAP_SECONDS=5
# WHATSAPP_DAILY_LIMIT=200
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_COUNTRY_CODE=91

# --- Seed (optional) ---
# SEED_PASSWORD=choose-a-password      # otherwise one is generated and printed once
# SEED_OWNER_EMAIL=you@example.com
# SEED_OWNER_NAME=Your Name
